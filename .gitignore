# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.wrangler/
.open-next

/.claude
.agents/
.agents

# drive downloads
public/drive-download-*
# Videos fuente sueltos en public/: Cloudflare Pages rechaza cualquier asset
# de más de 25 MiB y tumba el build. Los videos se sirven desde R2.
public/*.mp4
public/*.mov

# showroom raw and processed media assets
raw_assets/
dist_assets/
public/plants/details/
test_dist_tmp/

